{
  "name": "todo-list",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": ".venv/Scripts/python.exe -m uvicorn server.main:app --reload --port 3100",
    "electron": "electron .",
    "electron:dev": "node scripts/dev-electron.mjs",
    "build:server": "node scripts/build-server.mjs",
    "dist": "npm run build && npm run build:server && .\\.tools\\node\\node.exe scripts\\build-app.mjs",
    "dist:dir": "npm run build && npm run build:server && .\\.tools\\node\\node.exe scripts\\build-app.mjs --dir"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.example.todolist",
    "productName": "Todo List",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Todo List",
      "include": "build/installer.nsh"
    },
    "directories": {
      "output": "release"
    }
  }
}
